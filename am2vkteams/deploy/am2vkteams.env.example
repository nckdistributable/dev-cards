# am2vkteams configuration — copy to /etc/am2vkteams.env and `chmod 600`.
# All configuration is via environment variables; nothing is hardcoded.

# --- Required ---------------------------------------------------------------

# VK Teams bot token, obtained from the Metabot (/newbot).
VKT_TOKEN=001.0000000000.0000000000:000000000

# Target chat id. For a group chat, get it via the bot API /events/get.
VKT_CHAT_ID=000000000000000000

# --- Optional ---------------------------------------------------------------

# VK Teams Bot API base URL. Default suits the public myteam.mail.ru install;
# corporate installations set their own URL here.
# VKT_API_URL=https://myteam.mail.ru/bot/v1

# Address the HTTP server listens on. Default: 127.0.0.1:9095
# LISTEN_ADDR=127.0.0.1:9095

# --- Optional LLM analysis (Numira) -----------------------------------------
# Enabled only when BOTH NUMIRA_URL and NUMIRA_TOKEN are set. When enabled,
# firing alerts get a short LLM analysis sent as a separate "🤖 …" message.

# NUMIRA_URL=https://numira.example.internal
# NUMIRA_TOKEN=replace-with-real-token
# NUMIRA_AGENT=default
