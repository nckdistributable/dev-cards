{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dev-cards/card.schema.json",
  "title": "Card",
  "type": "object",
  "required": ["id", "course", "topic", "level", "type", "concept", "question", "explanation"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "course": { "type": "string" },
    "topic": { "type": "string" },
    "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "type": { "type": "string", "enum": ["concept", "compiles", "output", "choice", "fill"] },
    "concept": { "type": "string", "minLength": 1 },
    "code": { "type": "string" },
    "question": { "type": "string", "minLength": 1 },
    "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "answer": { "type": "integer", "minimum": 0 },
    "expected": { "type": "string", "enum": ["compiles", "fails"] },
    "expected_output": { "type": "string" },
    "explanation": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "type": { "const": "compiles" } }, "required": ["type"] },
  "then": { "required": ["expected"] }
}
